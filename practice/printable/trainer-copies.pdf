BT 1 0 0 1 0 459 Tm /F3 9 Tf 12 TL (<!doctype html>) Tj T* (<html lang="en">) Tj T* (<head>) Tj T* (<meta charset="utf-8">) Tj T* (<title>Live course search</title>) Tj T* (<style>) Tj T* (  body { font: 1rem system-ui; margin: 2rem; }) Tj T* (  #courses li { padding: .4rem; border-bottom: 1px solid #ddd; }) Tj T* (</style>) Tj T* (</head>) Tj T* (<body>) Tj T* (<h1>Live course search</h1>) Tj T* (<label for="search">Search courses</label>) Tj T* (<input id="search" type="search" placeholder="Filter by course">) Tj T* (<ul id="courses">) Tj T* (  <li>Java Basics</li>) Tj T* (  <li>SQL Joins</li>) Tj T* (  <li>Web Essentials</li>) Tj T* (</ul>) Tj T* (<p id="empty" hidden aria-live="polite">No matches</p>) Tj T* (<script>) Tj T* (  const search = document.querySelector\('#search'\);) Tj T* (  const courses = document.querySelectorAll\('#courses li'\);) Tj T* (  const empty = document.querySelector\('#empty'\);) Tj T*  T* (  search.addEventListener\('input', \(\) => {) Tj T* (    const query = search.value.trim\(\).toLowerCase\(\);) Tj T* (    let matches = 0;) Tj T*  T* (    for \(const course of courses\) {) Tj T* (      const visible = course.textContent.toLowerCase\(\).includes\(query\);) Tj T* (      course.hidden = !visible;) Tj T* (      if \(visible\) matches += 1;) Tj T* (    }) Tj T* (    empty.hidden = matches !== 0;) Tj T* (  }\);) Tj T* (</script>) Tj T* (</body>) Tj T* (</html>) Tj T* ET
