{
  "name": "assessment-training",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Topic-wise assessment practice in MDX, with answers and explanations.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node scripts/content.mjs sync",
    "check": "node scripts/content.mjs check",
    "build": "npm run sync && node scripts/build-site.mjs",
    "dev": "npm run build && node scripts/preview.mjs",
    "test": "npm run check && node --test scripts/search.test.mjs",
    "test:site": "node scripts/check-site.mjs"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1",
    "yaml": "2.9.1"
  }
}
